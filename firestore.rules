rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Admin authentication
    // "यहाँ अपनी Admin Email दर्ज करें"
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "sudhathawkar7@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // Wallpapers Collection
    match /wallpapers/{wallpaperId} {
      // Anyone can read active wallpapers
      allow read: if resource.data.isActive == true || isAdmin();

      // Users can increment download/view metrics
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['downloadsCount', 'viewsCount'])
                    || isAdmin();

      // Only authenticated admin can create, delete, or modify full wallpaper records
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
                    || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // App Settings & Ads Configuration
    match /app_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Push Notifications History
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
  }
}
